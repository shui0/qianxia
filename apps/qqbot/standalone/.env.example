ONEBOT_V11_ACCESS_TOKEN=replace-with-a-random-token
QIANXIA_MODEL_BASE_URL=https://api.deepseek.com/v1
QIANXIA_MODEL=deepseek-chat
QIANXIA_MODEL_API_KEY=replace-with-your-model-api-key
QIANXIA_GROUPS=[]
QIANXIA_MEMORY_GROUPS=[]
QIANXIA_PROACTIVE_ENABLED=true
QIANXIA_PROACTIVE_GROUPS=[]
QIANXIA_SEARCH_ENABLED=true
QIANXIA_SEARCH_PROVIDER=exa
# Exa 官方匿名入口有速率限制，可选填自己的 Key（仅在本机配置，不要提交）。
# QIANXIA_EXA_API_KEY=
QIANXIA_SEARCH_FALLBACK=true
QIANXIA_PIXIV_ENABLED=true
QIANXIA_PIXIV_AI_ENABLED=true
QIANXIA_VISION_ENABLED=true
# 可选：Pixiv 默认使用系统代理，也可单独配置代理。
# QIANXIA_PIXIV_PROXY=http://127.0.0.1:7897
# 搜索后批量读取命中网页正文，失败时保留原搜索摘要。
QIANXIA_SEARCH_READ_ENABLED=true
QIANXIA_MAIMAI_JP_REFRESH_ENABLED=true
QIANXIA_MAIMAI_JP_REFRESH_HOUR=8
# 默认通过系统网页代理搜索；本地模型请求仍绕过代理。
# QIANXIA_SEARCH_BACKEND=bing,yahoo
# QIANXIA_SEARCH_PROXY=http://127.0.0.1:7897
# QIANXIA_DEFENSE_OWNER_QQ=123456789
# QIANXIA_PROACTIVE_KEYWORDS=["舞萌","maimai","音击","オンゲキ","ongeki","时代剧","爬树","野外探险"]
QIANXIA_BILI_POST_USERS=[]
# QIANXIA_STICKER_DIR=D:/path/to/stickers
# QIANXIA_TTS_URL=http://127.0.0.1:8000/tts
# QIANXIA_DIRECT_PROMPT=D:/path/to/direct.txt
# QIANXIA_GROUP_PROMPT=D:/path/to/group.txt
